# Secreto para firmar el JWT de sesión. Mínimo 32 caracteres.
# Genera uno con: openssl rand -base64 48
AUTH_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres

# URL base del backend. Vacía = mismo origen (route handlers de Next en el demo).
NEXT_PUBLIC_API_BASE_URL=

# Opcionales del demo (por defecto: ./data, ./uploads y config/catalogo.json).
# DATA_DIR=
# UPLOADS_DIR=
# CATALOGO_PATH=

# Secreto para firmar las URLs de subida de archivos (SPEC 05). Mínimo 32 caracteres.
# Genera uno con: openssl rand -base64 48
AUTH_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres

# Llave RS256 de la sesión (SPEC 11) y su kid. Obligatorias: genera las dos líneas con
#   pnpm generar-llaves
AUTH_PRIVATE_KEY=
AUTH_KEY_ID=
# Rotación (opcional): la llave pública anterior y su kid siguen verificando sus
# tokens y se publican en /.well-known/jwks.json hasta que los quites.
# AUTH_PUBLIC_KEY_ANTERIOR=
# AUTH_KEY_ID_ANTERIOR=
# Emisor (iss) de los tokens: el origen de la tienda. Por omisión http://localhost:3000.
# AUTH_ISSUER=

# URL base del backend. Vacía = mismo origen (route handlers de Next en el demo).
NEXT_PUBLIC_API_BASE_URL=

# Opcionales del demo (por defecto: ./data, ./uploads y config/catalogo.json).
# DATA_DIR=
# UPLOADS_DIR=
# CATALOGO_PATH=
